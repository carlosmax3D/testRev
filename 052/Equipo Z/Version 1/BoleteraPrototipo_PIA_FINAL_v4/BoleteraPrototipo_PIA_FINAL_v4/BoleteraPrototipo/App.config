<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <!-- Cambia JEDAN\SQLEXPRESS por el nombre de tu servidor SQL Server.
         Integrated Security = entra con tu usuario de Windows.
         TrustServerCertificate evita el error de certificado en SQL Express local. -->
    <add name="BoleteraDB"
         connectionString="Server=JEDAN\SQLEXPRESS;Database=BoleteraDB;Integrated Security=true;TrustServerCertificate=True;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
